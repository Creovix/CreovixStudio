# Public (browser) — also accepted without VITE_ prefix via vite.config mapping
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Server (API / SSR) — required for OAuth + server functions
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional aliases (same values as publishable/anon key)
# SUPABASE_ANON_KEY=
# VITE_SUPABASE_ANON_KEY=

# Site (required in production — used for OAuth redirect_uri)
PUBLIC_SITE_URL=https://cylixstudio.com
