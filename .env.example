# Public (browser) — also accepted without VITE_ prefix via vite.config mapping
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Server (API / SSR) — required for OAuth + server functions
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional aliases (same values as publishable/anon key)
# SUPABASE_ANON_KEY=
# VITE_SUPABASE_ANON_KEY=

# Site (required in production — used for OAuth redirect_uri; no trailing slash).
# Canonical host is www because Vercel 308-redirects apex → www.cylixstudio.com.
# If you set the apex URL by mistake, the server rewrites it to www.
PUBLIC_SITE_URL=https://www.cylixstudio.com

# Kick OAuth (authorize ONLY on id.kick.com — never api.kick.com/oauth).
# Register this Redirect URI in the Kick developer console EXACTLY:
#   https://www.cylixstudio.com/api/auth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Optional space-separated override if the Kick app only enables a subset of scopes:
# KICK_OAUTH_SCOPES=user:read channel:read chat:write events:subscribe

# Twitch OAuth — register this Redirect URI in the Twitch console EXACTLY:
#   https://www.cylixstudio.com/api/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
