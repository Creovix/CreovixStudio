# Streamlabs / StreamElements / TikTok / YouTube
STREAMLABS_CLIENT_ID=
STREAMLABS_CLIENT_SECRET=
STREAMELEMENTS_CLIENT_ID=
STREAMELEMENTS_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
YOUTUBE_API_KEY=

# X (Twitter) API v2 app-only bearer token — live follower lookup
X_BEARER_TOKEN=
